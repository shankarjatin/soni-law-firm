# Public base URL (canonical links, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" ONLY on production. Anything else = noindex + robots disallow (staging/previews).
NEXT_PUBLIC_SITE_INDEXABLE=false

# Inquiry email delivery via Resend (provider pending approval — TRD §2).
# Without these, the form works in development (nothing sent) and returns 503 in production.
RESEND_API_KEY=
INQUIRY_NOTIFICATION_EMAIL=
INQUIRY_FROM_EMAIL=
